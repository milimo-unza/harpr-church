# Harpr environment template.
# Copy to .env and fill in. .env is gitignored.

# Django
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=1
ALLOWED_HOSTS=*

# Optional — enables the AI Insights page.
# Get one free at https://console.groq.com/keys
GROQ_API_KEY=

# Email (Resend). Free tier: 3,000/month, 100/day.
# Sign up at https://resend.com, get an API key at https://resend.com/api-keys.
# Free tier restriction: can only send to the account's own address until
# a custom domain is verified at https://resend.com/domains.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=onboarding@resend.dev
